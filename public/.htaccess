# Hostinger (Apache / LiteSpeed) — single-page app routing.
# Real files (index.html, /assets/*, images, sitemap…) are served as they are.
# Every other address (/technologies, /studios, /construction, …) gets index.html,
# and the app shows the right page. Without this, opening those addresses directly gives a 404.

Options -MultiViews
DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Existing file or folder → serve it.
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Anything else → the app.
  RewriteRule ^ index.html [L]
</IfModule>

<IfModule mod_headers.c>
  # Built JS / CSS / fonts have a content hash in their name → safe to cache for a year.
  <FilesMatch "\.(js|css|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # The page itself must always be fresh so visitors get new deployments straight away.
  <FilesMatch "^index\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
